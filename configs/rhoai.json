{
  "name": "Red Hat OpenShift AI",
  "description": "RHOAI operator and all managed components across namespaces",
  "operators": [
    {
      "csv": "rhods-operator",
      "namespace": "redhat-ods-operator",
      "entrypoints": [
        { "kind": "DataScienceCluster", "name": "default-dsc" },
        { "kind": "DSCInitialization", "name": "default-dsci" }
      ],
      "watchNamespaces": [
        "redhat-ods-operator",
        "redhat-ods-applications",
        "redhat-ods-monitoring",
        "rhods-notebooks"
      ]
    },
    {
      "csv": "authorino-operator",
      "namespace": "redhat-ods-operator"
    },
    {
      "csv": "servicemeshoperator3",
      "namespace": "redhat-ods-operator"
    }
  ],
  "extraLinks": [
    {
      "comment": "DSC and DSCI are user-created singletons, link them to the operator CSV",
      "from": { "kind": "ClusterServiceVersion", "namePrefix": "rhods-operator" },
      "to": [
        { "kind": "DataScienceCluster" },
        { "kind": "DSCInitialization" }
      ]
    }
  ]
}
